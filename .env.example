# Copy to .env.local and fill in real values. Never commit .env.local.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_DB_PASSWORD=<postgres-password>
SUPABASE_PROJECT_REF=<project-ref>

# Password used to log in to the app
APP_PASSWORD=<app-password>
# Any long random string; used to sign the session cookie
SESSION_SECRET=<random-hex-string>
